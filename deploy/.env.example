# Production configuration for deploy/docker-compose.prod.yml.
# Copy to deploy/.env, fill in every value, and keep it out of git.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (base64url is safe inside DATABASE_URL — avoid passwords with @ : / ? #)

# Public hostname. Its DNS A/AAAA record must point at this server, and ports
# 80 + 443 must be open, for Caddy to obtain the TLS certificate.
DOMAIN=central.example.edu

POSTGRES_PASSWORD=

# --- Auth: required, >= 32 chars, must differ from each other ---
JWT_ACCESS_SECRET=
# Never rotate the pepper casually: every stored password hash depends on it.
PASSWORD_PEPPER=

# Restrict sign-up to university addresses (blank allows any domain).
ALLOWED_EMAIL_DOMAIN=aust.edu

# --- Mail: required in production (password reset, verification) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AUST Central <no-reply@central.example.edu>

# --- Rate limits (per client IP) ---
# Students on campus Wi-Fi usually share ONE public IP, so per-IP limits are
# shared by everyone on campus. Signed-in API traffic is already bucketed per
# user; these two are not, because their callers are not signed in yet.
# Sign-in/registration/reset: brute force is also stopped per account (5
# failures lock it for 15 min), so size this for a busy lab, not for one user.
AUTH_RATE_LIMIT_MAX=60
# Token refresh (once per page load and every 15 minutes per session).
REFRESH_RATE_LIMIT_MAX=600

LOG_LEVEL=info
