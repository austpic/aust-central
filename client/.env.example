# Copy to .env.local (or .env) and adjust. Not required for local dev against
# the default server — see src/api/config.ts for the fallback.

# Defaults to http://localhost:3000/api/v1 when unset.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Production (client/Dockerfile) builds with the relative /api/v1: the API is
# served from the same origin by Caddy, which the SameSite=Strict refresh
# cookie requires.
