<?xml version="1.0" encoding="utf-8"?>
<!--
  Network policy.

  Cleartext HTTP is denied by default (Android's own default since API 28) and
  re-enabled ONLY for the loopback addresses a developer's machine uses:

    10.0.2.2   the host, as seen from the Android emulator
    127.0.0.1  the device itself
    localhost  same

  Without this exception the app cannot reach `http://10.0.2.2:3000` during
  development and every request fails with a cleartext-not-permitted error.

  Any real deployment must be HTTPS: no production hostname is listed here, so
  a plain-HTTP call to a remote server is refused by the platform rather than
  silently sending tokens in the clear.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
