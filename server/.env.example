# Copy to .env and fill in. Never commit .env.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000

# Matches the docker-compose postgres service.
DATABASE_URL=postgresql://aust:aust_dev_password@localhost:5434/aust_central?schema=public

# --- Auth (REQUIRED, min 32 chars each, must differ from each other) ---
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-000000
PASSWORD_PEPPER=replace-me-with-a-different-48-byte-random-str

JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=10

# Restrict sign-up to university addresses. Leave unset/blank to allow any
# domain. Registration only — existing accounts of any domain (demo/seeded
# included) can still log in.
ALLOWED_EMAIL_DOMAIN=aust.edu

# --- CORS: comma-separated allowlist, never "*" ---
# :5173 is the Vite dev server (client/); :3000/:8080 cover other local tools.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# --- Uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
MAX_UPLOADS_PER_REQUEST=6

# --- Mail: unset in dev logs the email to stdout instead of sending ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=true
MAIL_FROM=AUST Central <no-reply@aust-central.local>
